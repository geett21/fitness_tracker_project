# Copy these values into your system environment; do not commit a real key.
# Replace these placeholders with deployment-specific values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=your_openai_api_key_here
# Optional: choose a model available to your OpenAI project.
OPENAI_MODEL=gpt-5
# Production password reset email configuration (optional in local DEBUG mode).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=fitness-tracker@example.com
FEEDBACK_EMAIL=feedback@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
