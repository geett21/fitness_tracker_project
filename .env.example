# Copy these values into your system environment; do not commit a real key.
# Local development values. Before deployment, set DEBUG=False and use a real
# SECRET_KEY and the public host name(s) in ALLOWED_HOSTS.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=your_openai_api_key_here
# Optional: choose a model available to your OpenAI project.
OPENAI_MODEL=gpt-5
# In DEBUG mode, password-reset messages use the console backend by default.
# Configure real SMTP values before production deployment.
DEFAULT_FROM_EMAIL=fitness-tracker@example.com
FEEDBACK_EMAIL=feedback@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
