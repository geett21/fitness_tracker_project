{% extends "base.html" %}

{% block content %}

<div class="container mt-5">

    <div class="card">

        <div class="card-header bg-danger text-white">
            Delete Water Intake
        </div>

        <div class="card-body">

            <h5>
                Are you sure you want to delete this water record?
            </h5>

            <p>

                <strong>{{ water.amount }} Liters</strong>

                on

                <strong>{{ water.date }}</strong>

            </p>

            <form method="POST">

                {% csrf_token %}

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a href="{% url 'water_list' %}" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

{% endblock %}